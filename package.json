{
  "name": "perlas-landing-page",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "setup": "node scripts/setup-local.mjs && npm run setup:images",
    "setup:images": "node scripts/image-reference.mjs --setup",
    "doctor": "node scripts/doctor.mjs",
    "dev": "vite",
    "dev:local": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:api": "php -S 127.0.0.1:8080 -t server/public server/public/index.php",
    "build": "tsc -b && vite build",
    "build:pages": "npm run build && node scripts/prepare-pages.mjs",
    "preview": "vite preview",
    "preview:local": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node --test src/analytics.test.mjs src/QuickContactForm.test.mjs scripts/legacy-redirects.test.mjs",
    "test:php": "php server/tests/test.php",
    "check": "npm test && npm run test:php && npm run build:pages && npm run check:seo && npm run check:images:reference",
    "lint": "tsc -b --pretty false",
    "check:seo": "node scripts/check-seo-build.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "check:images": "node scripts/optimize-images.mjs --check",
    "check:images:reference": "node scripts/image-reference.mjs --check"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.5",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "0.35.4",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  }
}
