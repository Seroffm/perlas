# Optional: URL des späteren Backends, zum Beispiel https://api.perlas.de
# Das Frontend sendet Bewerbungen dann als multipart/form-data an
# POST {VITE_PERLAS_API_URL}/career-applications.
VITE_PERLAS_API_URL=

# Präsentationsmodus nur für die lokale Entwicklung. In produktiven Builds
# wird nie ein Versand-Erfolg ohne tatsächliche Übermittlung angezeigt.
VITE_PERLAS_DEMO_FORM_SUCCESS=true

# Für den späteren Produktivbetrieb auf der eigenen Domain.
PERLAS_SITE_URL=https://www.perlas.de/
PERLAS_INDEX_SITE=true
