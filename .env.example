# Öffentliche Backend-Adresse (kein API-Schlüssel). Die Formulare senden
# Multipart-Anfragen an /quote-requests, /contact-requests und /career-applications.
VITE_PERLAS_API_URL=https://api.perlas.de

# Präsentationsmodus nur für die lokale Entwicklung. In produktiven Builds
# wird nie ein Versand-Erfolg ohne tatsächliche Übermittlung angezeigt.
VITE_PERLAS_DEMO_FORM_SUCCESS=true

# Öffentliche Domain des Produktivbetriebs.
PERLAS_SITE_URL=https://www.perlas.de/
PERLAS_INDEX_SITE=true

# Resend-Schlüssel ausschließlich auf dem Server hinterlegen, niemals als VITE_*
# oder in einer ins Repository aufgenommenen Datei. Siehe server/README.md.
